{
  "appId": "com.thesilentnights.veloscriptsmanager",
  "productName": "VeloScriptsManager",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*"
  ],
  "extraResources": [
    {
      "from": "go-build/server.exe",
      "to": "server.exe"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
